{
  "components": {
    "schemas": {
      "AudioView": {
        "description": "A short-lived URL for a stage's audio: canonical 48 kHz mono signed 16-bit little-endian PCM.",
        "properties": {
          "expires_in_secs": {
            "description": "Seconds the URL stays valid.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "url": {
            "description": "Where to fetch the audio from. Not stable: ask again after it expires.",
            "type": "string"
          }
        },
        "required": [
          "url",
          "expires_in_secs"
        ],
        "type": "object"
      },
      "ChainView": {
        "description": "A chain, source first.",
        "properties": {
          "stages": {
            "description": "The stages, oldest first.",
            "items": {
              "$ref": "#/components/schemas/EntryView"
            },
            "type": "array"
          },
          "truncated": {
            "description": "Set to \"depth_cap\" when the walk stopped before reaching a source.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "stages"
        ],
        "type": "object"
      },
      "ClientEvent": {
        "additionalProperties": false,
        "description": "One event as the browser reports it.",
        "properties": {
          "event_id": {
            "description": "Chosen by the browser, 16 to 64 characters from `A-Z a-z 0-9 _ -`. The dedupe key: an id\nalready stored is not stored again.",
            "type": "string"
          },
          "kind": {
            "description": "One of `roll_opened`, `stage_played`, `flip_started`.",
            "type": "string"
          },
          "occurred_at_ms": {
            "description": "When it happened by the browser's clock, milliseconds since the Unix epoch. A time far from\nthe server's is replaced by the nearest acceptable one.",
            "format": "int64",
            "type": "integer"
          },
          "publication_id": {
            "description": "The public id of the stage (for a roll, its last stage). Events naming a publication that\ndoes not exist are dropped.",
            "type": "string"
          },
          "session_id": {
            "description": "The page load's session id, 8 to 64 characters from `A-Z a-z 0-9 _ -`.",
            "type": "string"
          }
        },
        "required": [
          "event_id",
          "session_id",
          "kind",
          "occurred_at_ms",
          "publication_id"
        ],
        "type": "object"
      },
      "CutRequest": {
        "additionalProperties": false,
        "description": "A cut of the parent's audio, in frames of 48 kHz mono audio, half-open.",
        "properties": {
          "end": {
            "description": "First frame not included.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "start": {
            "description": "First frame included.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "type": "object"
      },
      "CutView": {
        "description": "A frame range of 48 kHz audio, half-open.",
        "properties": {
          "end": {
            "description": "First frame not included.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "start": {
            "description": "First frame included.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "type": "object"
      },
      "DeclarationRequest": {
        "additionalProperties": false,
        "description": "The declaration the visitor accepted.",
        "properties": {
          "basis": {
            "description": "`own_recording` or `right_to_share`.",
            "type": "string"
          },
          "statement": {
            "description": "The statement, exactly as shown: it must equal the service's declaration text.",
            "type": "string"
          }
        },
        "required": [
          "statement",
          "basis"
        ],
        "type": "object"
      },
      "DetailsView": {
        "description": "The exact facts, one level down from the credit lines.",
        "properties": {
          "cut": {
            "$ref": "#/components/schemas/CutView",
            "description": "The cut, computed."
          },
          "declared_at_ms": {
            "description": "For a source a visitor published: when they accepted the rights declaration, milliseconds\nsince the Unix epoch. The declaration is shown as declared, never as established.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "output_blob": {
            "description": "SHA-256 of this stage's audio.",
            "type": "string"
          },
          "record_id": {
            "description": "The content record id: SHA-256 of its canonical bytes. It proves which bytes, nothing more.",
            "type": "string"
          },
          "renderer": {
            "$ref": "#/components/schemas/RendererView",
            "description": "The renderer."
          },
          "source_blob": {
            "description": "SHA-256 of the audio the cut was taken from.",
            "type": "string"
          },
          "speed": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SpeedView",
                "description": "The speed, absent for a source."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "record_id",
          "source_blob",
          "output_blob",
          "cut",
          "renderer"
        ],
        "type": "object"
      },
      "EntryView": {
        "description": "A position in a chain.",
        "oneOf": [
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/StageView",
                "description": "A stage that was read and may be heard."
              },
              {
                "properties": {
                  "state": {
                    "enum": [
                      "available"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "state"
                ],
                "type": "object"
              }
            ],
            "description": "A stage that was read and may be heard."
          },
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/RemovedView",
                "description": "A hidden stage: \"no longer here\". Its credit stays; its audio is not served."
              },
              {
                "properties": {
                  "state": {
                    "enum": [
                      "no_longer_here"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "state"
                ],
                "type": "object"
              }
            ],
            "description": "A hidden stage: \"no longer here\". Its credit stays; its audio is not served."
          },
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/RemovedView",
                "description": "A stage built on one that is hidden for rights: held. Its credit stays; its audio is not\nserved while that hide stands, and it plays again when the hide is cleared."
              },
              {
                "properties": {
                  "state": {
                    "enum": [
                      "held"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "state"
                ],
                "type": "object"
              }
            ],
            "description": "A stage built on one that is hidden for rights: held. Its credit stays; its audio is not\nserved while that hide stands, and it plays again when the hide is cleared."
          },
          {
            "description": "A parent the chain names but could not be read. The chain is never silently shortened.",
            "properties": {
              "id": {
                "description": "The id the child names as its parent.",
                "type": "string"
              },
              "state": {
                "enum": [
                  "unavailable"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "state"
            ],
            "type": "object"
          }
        ]
      },
      "FlipItem": {
        "description": "One flip of a stage, as the list shows it. No audio and nothing private: the flip's own page\ngives its audio, and no manage key or hash of one is ever part of this shape.",
        "properties": {
          "author": {
            "description": "Maker's name as typed. Plain text, never a handle.",
            "type": "string"
          },
          "created_at_ms": {
            "description": "Creation time, milliseconds since the Unix epoch.",
            "format": "int64",
            "type": "integer"
          },
          "cut": {
            "$ref": "#/components/schemas/CutView",
            "description": "The cut of the parent, computed."
          },
          "frames": {
            "description": "How many frames of 48 kHz audio the flip comes out as, computed.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "id": {
            "description": "Public id of the flip.",
            "type": "string"
          },
          "speed": {
            "$ref": "#/components/schemas/SpeedView",
            "description": "The speed, computed."
          },
          "title": {
            "description": "Title as typed.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "author",
          "created_at_ms",
          "cut",
          "speed",
          "frames"
        ],
        "type": "object"
      },
      "FlipsView": {
        "description": "A page of the flips of a stage.",
        "properties": {
          "flips": {
            "description": "This page, newest first.",
            "items": {
              "$ref": "#/components/schemas/FlipItem"
            },
            "type": "array"
          },
          "next": {
            "description": "Pass this as `cursor` to read the page after this one; absent on the last page.",
            "type": [
              "string",
              "null"
            ]
          },
          "total": {
            "description": "How many flips of the stage are listed in all (not hidden).",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "total",
          "flips"
        ],
        "type": "object"
      },
      "ForkPermissionRequest": {
        "additionalProperties": false,
        "description": "Close or reopen a stage to new flips.",
        "properties": {
          "permitted": {
            "description": "True to allow new flips of this stage, false to close it. Existing flips are untouched.",
            "type": "boolean"
          }
        },
        "required": [
          "permitted"
        ],
        "type": "object"
      },
      "IngestReceipt": {
        "description": "The receipt: deliberately all there is to learn.",
        "properties": {
          "accepted": {
            "description": "Events newly stored. Fewer than sent when some were repeats, named a publication that does\nnot exist, or the browser signalled that it must not be measured.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "accepted"
        ],
        "type": "object"
      },
      "IngestRequest": {
        "additionalProperties": false,
        "description": "A batch of events.",
        "properties": {
          "events": {
            "description": "The events, at most the configured batch size (20 by default).",
            "items": {
              "$ref": "#/components/schemas/ClientEvent"
            },
            "type": "array"
          }
        },
        "required": [
          "events"
        ],
        "type": "object"
      },
      "LineView": {
        "description": "One line of a credit block.",
        "properties": {
          "honesty": {
            "description": "\"declared\" (a person said it, as typed), \"computed\" (the system produced it) or \"unknown\".",
            "type": "string"
          },
          "role": {
            "description": "Role word: \"source\", \"flip\", \"flipped by\", \"cut\", \"speed\", \"licence\", \"renderer\", \"rights\".",
            "type": "string"
          },
          "value": {
            "description": "The value, as text.",
            "type": "string"
          }
        },
        "required": [
          "role",
          "value",
          "honesty"
        ],
        "type": "object"
      },
      "MakerState": {
        "description": "The state of a stage after a maker action.",
        "properties": {
          "fork_permitted": {
            "description": "Whether new flips of this stage are allowed.",
            "type": "boolean"
          },
          "withdrawn": {
            "description": "Whether the stage is hidden (withdrawn).",
            "type": "boolean"
          }
        },
        "required": [
          "fork_permitted",
          "withdrawn"
        ],
        "type": "object"
      },
      "Problem": {
        "description": "A problem-details document.",
        "properties": {
          "detail": {
            "description": "What went wrong this time, for a person.",
            "type": "string"
          },
          "field": {
            "description": "The request field the problem is about, when there is one.",
            "type": [
              "string",
              "null"
            ]
          },
          "retry_after_secs": {
            "description": "Seconds to wait before trying again, when waiting helps.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "rule": {
            "description": "A stable name for the rule that refused it, such as `too_long` or `inverted`.",
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "description": "The HTTP status.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "description": "A short summary of the kind.",
            "type": "string"
          },
          "type": {
            "description": "A URI naming the kind of problem; stable, so clients can switch on it.",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "type": "object"
      },
      "PublishFlipRequest": {
        "additionalProperties": false,
        "description": "A flip to publish. No audio travels: the server renders it.",
        "properties": {
          "author": {
            "description": "The maker's name as typed. Plain text, never a handle.",
            "type": "string"
          },
          "cut": {
            "$ref": "#/components/schemas/CutRequest",
            "description": "The cut of the parent's audio."
          },
          "parent_id": {
            "description": "Public id of the stage being flipped.",
            "type": "string"
          },
          "preview_hash": {
            "description": "SHA-256 (hex) of the audio the client's preview rendered. A cross-check only.",
            "type": [
              "string",
              "null"
            ]
          },
          "retry_key": {
            "description": "Chosen by the client when the publish step opens: 16 to 128 characters from `A-Z a-z 0-9 . _ : -`.\nRepeating a request with the same key and the same content returns the same publication.",
            "type": "string"
          },
          "speed": {
            "$ref": "#/components/schemas/SpeedRequest",
            "description": "The varispeed fraction."
          },
          "title": {
            "description": "Title as typed; links and handles are removed, and the response says so.",
            "type": "string"
          }
        },
        "required": [
          "parent_id",
          "cut",
          "speed",
          "title",
          "author",
          "retry_key"
        ],
        "type": "object"
      },
      "PublishSourceRequest": {
        "additionalProperties": false,
        "description": "A source to publish.",
        "properties": {
          "audio": {
            "description": "Base64 (standard alphabet, no line breaks) of canonical audio: 48 kHz, mono, signed 16-bit\nlittle-endian, no header; at most 15 seconds.",
            "type": "string"
          },
          "author": {
            "description": "The maker's name as typed. Plain text, never a handle.",
            "type": "string"
          },
          "declaration": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/DeclarationRequest",
                "description": "The rights declaration. Required."
              },
              {
                "type": "null"
              }
            ]
          },
          "retry_key": {
            "description": "Chosen by the client when the publish step opens: 16 to 128 characters from `A-Z a-z 0-9 . _ : -`.",
            "type": "string"
          },
          "title": {
            "description": "Title as typed; links and handles are removed, and the response says so.",
            "type": "string"
          }
        },
        "required": [
          "audio",
          "title",
          "author",
          "retry_key"
        ],
        "type": "object"
      },
      "PublishedFlip": {
        "description": "The result of publishing.",
        "properties": {
          "adjusted_fields": {
            "description": "Fields whose text was changed by removing a link or a handle.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "manage_key": {
            "description": "The key that manages this publication. Shown once, in the response that creates it, and\nnever again: only its hash is stored. Absent when the request was a replay.",
            "type": [
              "string",
              "null"
            ]
          },
          "preview_matches": {
            "description": "Whether the client's preview hash matched the server's render; absent when none was sent.\nOn a mismatch the server's audio is what was stored.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "publication": {
            "$ref": "#/components/schemas/EntryView",
            "description": "The new publication, as one entry of a chain."
          }
        },
        "required": [
          "publication",
          "adjusted_fields"
        ],
        "type": "object"
      },
      "PublishedSource": {
        "description": "The result of publishing a source.",
        "properties": {
          "adjusted_fields": {
            "description": "Fields whose text was changed by removing a link or a handle.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "manage_key": {
            "description": "The key that manages this publication. Shown once, in the response that creates it. Absent\nwhen the request was a replay.",
            "type": [
              "string",
              "null"
            ]
          },
          "publication": {
            "$ref": "#/components/schemas/EntryView",
            "description": "The new publication, as one entry of a chain."
          }
        },
        "required": [
          "publication",
          "adjusted_fields"
        ],
        "type": "object"
      },
      "RemovedView": {
        "description": "A stage that is hidden: its credit stays, its audio is not served, and the chain around it is\nnot shortened.",
        "properties": {
          "author": {
            "description": "Maker's name as typed.",
            "type": "string"
          },
          "created_at_ms": {
            "description": "Creation time, milliseconds since the Unix epoch.",
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "description": "Public id of the publication.",
            "type": "string"
          },
          "kind": {
            "description": "\"source\" or \"flip\".",
            "type": "string"
          },
          "lines": {
            "description": "Credit lines, each with its honesty state.",
            "items": {
              "$ref": "#/components/schemas/LineView"
            },
            "type": "array"
          },
          "parent_id": {
            "description": "Id of the parent publication, absent for a source.",
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "description": "Why it is hidden: \"withdrawn\" or \"rights\".",
            "type": "string"
          },
          "title": {
            "description": "Title as typed.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "reason",
          "title",
          "author",
          "created_at_ms",
          "lines"
        ],
        "type": "object"
      },
      "RendererView": {
        "description": "Which renderer produced the audio.",
        "properties": {
          "name": {
            "description": "Renderer name.",
            "type": "string"
          },
          "version": {
            "description": "Renderer version.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "wasm_sha256": {
            "description": "SHA-256 of the `.wasm`, lowercase hex.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "wasm_sha256"
        ],
        "type": "object"
      },
      "ReportReceived": {
        "description": "The plain confirmation of a report.",
        "properties": {
          "received": {
            "description": "Always true: the report was stored.",
            "type": "boolean"
          }
        },
        "required": [
          "received"
        ],
        "type": "object"
      },
      "ReportRequest": {
        "additionalProperties": false,
        "description": "A request that a publication be looked at.",
        "properties": {
          "category": {
            "description": "One of `rights`, `private_conversation`, `harmful`, `spam`, `other`.",
            "type": "string"
          },
          "note": {
            "description": "An optional short note for the operator, at most 500 characters. Never shown publicly.",
            "type": [
              "string",
              "null"
            ]
          },
          "publication_id": {
            "description": "Public id of the publication.",
            "type": "string"
          }
        },
        "required": [
          "publication_id",
          "category"
        ],
        "type": "object"
      },
      "SpeedRequest": {
        "additionalProperties": false,
        "description": "The speed as an exact fraction: `p/q` input frames per output frame, between 1/4 and 4.",
        "properties": {
          "p": {
            "description": "Numerator, 1 to 2^20.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "q": {
            "description": "Denominator, 1 to 2^20.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "p",
          "q"
        ],
        "type": "object"
      },
      "SpeedView": {
        "description": "The exact speed fraction and the method that applied it.",
        "properties": {
          "method": {
            "description": "Interpolation method id (1 is cubic Hermite).",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "p": {
            "description": "Numerator.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "q": {
            "description": "Denominator.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "p",
          "q",
          "method"
        ],
        "type": "object"
      },
      "StageView": {
        "description": "One stage that could be read. Its availability is the `state` of the entry that holds it.",
        "properties": {
          "audio": {
            "$ref": "#/components/schemas/AudioView",
            "description": "Where to hear it."
          },
          "author": {
            "description": "Maker's name as typed. Plain text, never a handle.",
            "type": "string"
          },
          "created_at_ms": {
            "description": "Creation time, milliseconds since the Unix epoch.",
            "format": "int64",
            "type": "integer"
          },
          "details": {
            "$ref": "#/components/schemas/DetailsView",
            "description": "The exact facts."
          },
          "flipped_count": {
            "description": "How many publications were flipped from this one, counted from publications data.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "fork_permitted": {
            "description": "Whether the maker allows new flips of this stage.",
            "type": "boolean"
          },
          "id": {
            "description": "Public id of the publication.",
            "type": "string"
          },
          "kind": {
            "description": "\"source\" or \"flip\".",
            "type": "string"
          },
          "lines": {
            "description": "Credit lines, each with its honesty state.",
            "items": {
              "$ref": "#/components/schemas/LineView"
            },
            "type": "array"
          },
          "parent_id": {
            "description": "Id of the parent publication, absent for a source.",
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "description": "Title as typed.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "author",
          "created_at_ms",
          "flipped_count",
          "fork_permitted",
          "lines",
          "details",
          "audio"
        ],
        "type": "object"
      },
      "SwitchView": {
        "description": "What the operator reads about the two switches, and what anyone may read at `/v1/features`. Publishing can be changed while the service\nruns; uploads are set when it starts (`GRAFT_UPLOADS`), so this only reports them.",
        "properties": {
          "publishing": {
            "description": "Whether publishing is open.",
            "type": "boolean"
          },
          "uploads": {
            "description": "Whether visitors may publish their own sources.",
            "type": "boolean"
          }
        },
        "required": [
          "publishing",
          "uploads"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Read a chain of stages, source first. Errors are RFC 9457 problem details.",
    "license": {
      "name": ""
    },
    "title": "graft API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/chains/{id}": {
      "get": {
        "operationId": "get_chain",
        "parameters": [
          {
            "description": "Public id of the last stage of the chain",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChainView"
                }
              }
            },
            "description": "The chain, source first"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No such publication"
          }
        },
        "summary": "The chain ending at a publication, source first.",
        "tags": [
          "routes"
        ]
      }
    },
    "/v1/events": {
      "post": {
        "operationId": "ingest_events",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestReceipt"
                }
              }
            },
            "description": "How many events were newly stored"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A field breaks a rule, or the batch is too large; `field` and `rule` say which"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "This visitor or session sent too much; `Retry-After` says when to try again"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Publishing, which includes event reporting, is switched off"
          }
        },
        "summary": "Report a batch of client events.",
        "tags": [
          "crate::ingest"
        ]
      }
    },
    "/v1/features": {
      "get": {
        "operationId": "get_features",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SwitchView"
                }
              }
            },
            "description": "Whether publishing and uploads are open"
          }
        },
        "summary": "What the service is open for right now: publishing (the kill switch) and visitors' own sources.\nTwo booleans and nothing else, so a page can say a door is closed before anything is sent\nthrough it.",
        "tags": [
          "routes"
        ]
      }
    },
    "/v1/publications": {
      "post": {
        "operationId": "publish_flip",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublishFlipRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishedFlip"
                }
              }
            },
            "description": "The same request was already published; nothing changed"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishedFlip"
                }
              }
            },
            "description": "Published; the manage key is in this response only"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The maker closed this stage to flips"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No such parent"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Key conflict, hidden parent or chain too deep"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A field breaks a rule; `field` and `rule` say which"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "This stage was flipped too often this hour, this visitor published too often (`rate-limited`), or everyone together reached the publish cap (`publish-cap`); `Retry-After` says when to try again"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Busy, send the same request again (`retry-later`); publishing is switched off (`publishing-off`); or there is no room for new audio (`storage-full`)"
          }
        },
        "summary": "Publish a flip of an existing stage.",
        "tags": [
          "publish"
        ]
      }
    },
    "/v1/publications/{id}": {
      "get": {
        "operationId": "get_publication",
        "parameters": [
          {
            "description": "Public id of the publication",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryView"
                }
              }
            },
            "description": "The publication, as one entry of a chain"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No such publication"
          }
        },
        "summary": "One publication.",
        "tags": [
          "routes"
        ]
      }
    },
    "/v1/publications/{id}/flips": {
      "get": {
        "operationId": "get_flips",
        "parameters": [
          {
            "description": "Public id of the stage",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Flips per page: 1 to 50, 24 when absent",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "The `next` of the page before; made for this stage only",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlipsView"
                }
              }
            },
            "description": "A page of the stage's flips"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A limit out of range, or a cursor that is not this stage's"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No such publication"
          }
        },
        "summary": "The flips of a stage, newest first.",
        "tags": [
          "crate::flips"
        ]
      }
    },
    "/v1/publications/{id}/fork-permission": {
      "put": {
        "operationId": "set_fork_permission",
        "parameters": [
          {
            "description": "Public id of the publication",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The manage key shown once when the publication was created",
            "in": "header",
            "name": "x-graft-manage-key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForkPermissionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MakerState"
                }
              }
            },
            "description": "The stage after the change; repeating the request changes nothing"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The manage key was not accepted (the same answer for every reason)"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Busy; send the same request again"
          }
        },
        "summary": "Close or reopen a stage to new flips. Existing flips and rolls are untouched.",
        "tags": [
          "maker"
        ]
      }
    },
    "/v1/publications/{id}/withdraw": {
      "post": {
        "operationId": "withdraw",
        "parameters": [
          {
            "description": "Public id of the publication",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The manage key shown once when the publication was created",
            "in": "header",
            "name": "x-graft-manage-key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MakerState"
                }
              }
            },
            "description": "The stage after the change; repeating the request changes nothing"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The manage key was not accepted (the same answer for every reason)"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Busy; send the same request again"
          }
        },
        "summary": "Withdraw a publication. It stays in every chain as \"no longer here\" with its credit; its audio\nis no longer served; stages built on it stay playable. Only the operator can undo it.",
        "tags": [
          "maker"
        ]
      }
    },
    "/v1/reports": {
      "post": {
        "operationId": "file_report",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportReceived"
                }
              }
            },
            "description": "The report was stored"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No such publication"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A field breaks a rule; `field` and `rule` say which"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "This visitor has filed too many reports lately; `Retry-After` says when to try again"
          }
        },
        "summary": "File a report about a publication. No account; no identity is collected.",
        "tags": [
          "moderation"
        ]
      }
    },
    "/v1/sources": {
      "post": {
        "operationId": "publish_source",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublishSourceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishedSource"
                }
              }
            },
            "description": "The same request was already published; nothing changed"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishedSource"
                }
              }
            },
            "description": "Published; the manage key is in this response only"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The retry key belongs to a different sound"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The body is larger than any allowed source"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A field or the audio breaks a rule; `field` and `rule` say which"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "This visitor published too often, or everyone together reached the publish cap"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Uploads are switched off (`uploads-off`), publishing is switched off (`publishing-off`), there is no room (`storage-full`), or busy (`retry-later`)"
          }
        },
        "summary": "Publish a sound the visitor made.",
        "tags": [
          "crate::source"
        ]
      }
    }
  }
}
